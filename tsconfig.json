{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "allowJs":false,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "sourceMap": true,
      "outDir": "dist",
      "skipLibCheck": true,
      "declaration": true,
      "declarationMap": true,
      "typeRoots": [
        "./node_modules/@types",
        "./ck/types"
      ],
    },
    "lib": ["ES2022"],
    "exclude": [
      "dist",
      "example.ts",
      "geminiConversationTest.ts",
      "**/*.spec.ts",
      "**/*.test.ts",
      "**/test/**",
      "**/tests/**",
      "**/test-helpers/**",
      "**/tests-helpers/**"
    ],
  }
  